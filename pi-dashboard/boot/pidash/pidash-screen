#!/bin/sh
# Runs inside cage, just before the browser: shows the splash, and a wide screen bigger than 1280x720
# is switched to 1280x720, which is less than half the work for the Pi.
# SCREEN_SIZE="native" in dashboard-settings.txt leaves the screen as it is.
if [ "$PIDASH_SCREEN_SIZE" != native ] && command -v wlr-randr >/dev/null; then
    timeout 10 wlr-randr 2>/dev/null | awk '
        /^[^ \t]/ { if (out == "") out = $1; else exit }
        $1 ~ /^[0-9]+x[0-9]+$/ && $2 == "px," {
            split($1, s, "x")
            if (/current/) { w = s[1]; h = s[2] }
            if ($1 == "1280x720" && $3 >= 50 && $3 < 61 && mode == "") mode = $1 "@" $3
        }
        END { if (w > 1280 && w * 9 == h * 16 && mode != "") print out, mode }' | {
        read -r OUT NEWMODE && [ -n "$NEWMODE" ] &&
            timeout 10 wlr-randr --output "$OUT" --mode "$NEWMODE" && echo "PiDash screen: $OUT set to $NEWMODE"
    }
fi
# the splash stays up until the dashboard is drawn over it
pidash-splash wayland &
exec "$@"
